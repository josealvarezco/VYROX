# Copia este archivo como .env y pon tus API keys de https://dashboard.api-football.com/register
# separadas por coma: si una agota su cuota diaria, la petición sigue con la siguiente.
# Sin API key, el backend sirve datos de ejemplo. API_FOOTBALL_KEY (una sola) también funciona.
API_FOOTBALL_KEYS=
# Segundos que se reutiliza la respuesta de API-Football (plan gratuito: 100 peticiones/día).
CACHE_TTL=300
# API key de Google Gemini (https://aistudio.google.com/apikey). Sin key, /api/predictions responde con un aviso de respaldo.
GEMINI_API_KEY=
